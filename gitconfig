[alias]
  vimdiff = "difftool -y -t vimdiff -R"
  cm = "commit"
  co = "checkout"
  ca = "commit -a --amend --no-edit"
  pf = "push origin -f"
  st = "status -sb"
  lg = "log --pretty=format:'%Cred%h%Creset -%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'"
  purr = "pull --rebase"
  graph = "log --graph --oneline --all"
  ignored = "ls-files --others -i --exclude-standard"
  wip = "commit -a -m 'WIP'"

[push]
  default = current

[diff]
  algorithm = patience

; Push over SSH, but clone and fetch over HTTPS so a machine without keys yet
; can still bootstrap. Private repos need `gh auth login` for the fetch side.
[url "ssh://git@github.com/"]
  pushInsteadOf = https://github.com/

; Commit signing lives here because the 1Password signer is at a different
; path on each OS. home-manager links the right gitconfig-<os> into place.
; Git ignores a missing include, so an unmanaged machine just doesn't sign.
[include]
  path = ~/.gitconfig.os

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[fetch]
	prune = true
[coderabbit]
	machineId = cli/4d2b8356341d458f903f20ac6cda39e3
